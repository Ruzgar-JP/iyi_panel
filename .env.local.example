# ---------------------------------------------------------------
# Bu dosyayı ".env.local" adıyla kopyalayın ve doldurun.
#
#   cp .env.local.example .env.local
#
# .env.local ASLA git'e girmez, kimseyle paylaşılmaz, e-postayla
# gönderilmez. İçindeki değerler sunucunun anahtarlarıdır.
#
# Ayrıntılı anlatım: KURULUM.md
# ---------------------------------------------------------------


# ===============================================================
# 1) VERİTABANI  (zorunlu)
# ===============================================================
# Gerçek PostgreSQL adresi. Kendi sunucunuzda kuruluysa:
#   postgres://iyipanel:SIFRE@localhost:5432/iyipanel
# Supabase / Neon gibi bir servis kullanıyorsanız sslmode=require ekleyin.
DATABASE_URL=postgres://kullanici:sifre@localhost:5432/iyipanel

# Aynı anda açık tutulacak veritabanı bağlantısı sayısı.
DB_MAX_BAGLANTI=10


# ===============================================================
# 2) ÇALIŞMA KİPİ  (zorunlu)
# ===============================================================
# 0 = canlı (gerçek ScaleTrade sunucusuna bağlanır)
# 1 = demo  (hiçbir istek dışarı gitmez, veriler uydurmadır)
# CANLIDA MUTLAKA 0 OLMALI.
DEMO_MOD=0


# ===============================================================
# 3) SCALETRADE (işlem platformu)  (zorunlu)
# ===============================================================
# DİKKAT: client.iyiyatirim.org CANLI sunucudur.
SCALETRADE_BASE_URL=https://client.iyiyatirim.org
SCALETRADE_BRAND=iyiyatirim
SCALETRADE_GROUP=Main

# Yönetici JWT'si. İki iş için gerekir:
#   - müşterinin işlem hesabı şifresini değiştirmek (PUT /password)
#   - yönetim panelinde güncel bakiyeyi okumak
# Boş bırakılırsa bu iki özellik kapanır, panelin geri kalanı çalışır.
SCALETRADE_MANAGER_TOKEN=


# ===============================================================
# 4) AYAR ŞİFRELEME ANAHTARI  (zorunlu)
# ===============================================================
# Panelden girilen SMTP şifresi veritabanına bu anahtarla şifrelenerek
# yazılır. Anahtar olmadan şifre kaydedilemez (kasıtlı — düz metin
# saklamamak için).
#
# Üretmek için sunucuda:
#   openssl rand -base64 32
#
# UYARI: Bu anahtarı sonradan değiştirirseniz kayıtlı SMTP şifresi
# okunamaz hâle gelir; panelden yeniden girmeniz gerekir.
AYAR_ANAHTARI=


# ===============================================================
# 5) KAYIT FORMU KORUMASI — Cloudflare Turnstile  (zorunlu)
# ===============================================================
# dash.cloudflare.com → Turnstile → Add site
# Alan adınızı yazıp iki anahtarı buraya kopyalayın.
#
# UYARI: Bu anahtarlar boşsa kayıt formu HİÇBİR kaydı kabul etmez
# (güvenli taraf: captcha yoksa kapı kapalı).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Yalnızca yerel testte captcha'yı atlamak için CAPTCHA_ATLA=1 eklenir.
# Üretim derlemesinde yok sayılır ama yine de canlı sunucuda BULUNMASIN.


# ===============================================================
# 6) SİTE ADRESİ  (önerilir)
# ===============================================================
# Şifre sıfırlama e-postalarındaki bağlantılar bu adresle üretilir.
# Boş bırakılırsa isteğin geldiği adres kullanılır — ters vekil (nginx)
# arkasında bu yanlış çıkabilir.
# Yönetim → Sistem sayfasından da girilebilir.
NEXT_PUBLIC_SITE_URL=https://panel.iyiyatirim.org


# ===============================================================
# 7) E-POSTA (SMTP)  (önerilir)
# ===============================================================
# ARTIK PANELDEN GİRİLEBİLİR:  Yönetim → Sistem → E-posta ayarları
# Oradan girip "Test gönder" ile doğrulayabilirsiniz; sunucuya
# dokunmaya gerek kalmaz.
#
# Aşağıdakiler yalnızca panelde hiç kayıt yoksa kullanılır (yedek).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=İyi Yatırım <destek@iyiyatirim.org>

# Şifre sıfırlama bağlantısının geçerlilik süresi (dakika)
SIFIRLAMA_DK=60


# ===============================================================
# 8) OTURUM SÜRELERİ (saat)
# ===============================================================
OTURUM_SAAT=8
YONETIM_OTURUM_SAAT=12


# ===============================================================
# 9) PARA ÇEKME / YATIRMA KURALLARI
# ===============================================================
BAKIYE_BEKLEME_SN=60      # bakiye sorguları arası bekleme
CEKIM_BEKLEME_DK=30       # iki çekim talebi arası bekleme
ACIK_CEKIM_ADEDI=1        # aynı anda açık bekleyen çekim talebi
MIN_TUTAR=10
MAX_TUTAR=1000000

# 1 = müşteri bonusu/krediyi nakit çekemez.  KAPATMAYIN:
# kapatılırsa müşteri kendisine ait olmayan parayı çekebilir.
CEKIMDE_BONUS_DUS=1
CEKIMDE_KREDI_DUS=1

# Yüklenebilecek belge boyutu (MB)
MAX_DOSYA_MB=8


# ===============================================================
# 10) GÖRÜNEN BİLGİLER
# ===============================================================
# Hata mesajlarında ve alt bilgide gösterilen destek adresi
NEXT_PUBLIC_DESTEK_EPOSTA=destek@iyiyatirim.org

# "İşlem terminaline git" butonunun hedefi
NEXT_PUBLIC_TERMINAL_URL=https://client.iyiyatirim.org/en/sign/in
